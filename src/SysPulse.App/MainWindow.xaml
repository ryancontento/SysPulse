<Window x:Class="SysPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:SysPulse.App.Components"
        Title="SysPulse"
        Icon="Assets/SysPulse.ico"
        Width="1000" Height="760"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TitleBarBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TitleBarMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TitleBarTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C9402F" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drawn in WPF so WindowChrome can handle dragging and snap layouts) -->
        <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="18,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Amber "power lamp" -->
                    <Border x:Name="PowerLamp"
                            Width="8" Height="8"
                            Margin="0,1,10,0"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentBrush}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="PowerLampGlow" Color="{StaticResource AccentColor}" BlurRadius="9" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource PlexMono}"
                               FontSize="15">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TitleBarTextBrush}" Text="SYS" /><Run Foreground="{StaticResource TitleBarMutedBrush}" Text="PULSE" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="PROFILE"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource PlexMono}"
                               FontSize="11"
                               Foreground="{StaticResource TitleBarMutedBrush}" />
                    <ComboBox x:Name="ProfileSelector"
                              Width="150"
                              FontSize="13"
                              WindowChrome.IsHitTestVisibleInChrome="True"
                              ToolTip="Windows power mode. Silent: best power efficiency. Default: balanced. Performance: best performance.">
                        <ComboBoxItem Content="Default" />
                        <ComboBoxItem Content="Silent" />
                        <ComboBoxItem Content="Performance" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <blazor:BlazorWebView x:Name="WebView"
                              Grid.Row="1"
                              HostPage="wwwroot\index.html"
                              BlazorWebViewInitializing="WebView_Initializing"
                              BlazorWebViewInitialized="WebView_Initialized">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>

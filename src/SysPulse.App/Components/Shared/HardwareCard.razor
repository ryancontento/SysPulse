<section class="card hardware-card">
    <header class="card-header">
        <h2 class="card-title">@Title</h2>
        <span class="card-detail" title="@Metrics.Name">@Metrics.Name</span>
    </header>

    <div class="body">
        <Gauge Value="Metrics.LoadPercent" Size="148" />
        <div class="bars">
            <MetricBar Label="Temperature" Value="Temperature" Unit="@TemperatureSymbol" Min="@TemperatureScale.Min" Max="@TemperatureScale.Max" />
            <MetricBar Label="Clock" Value="Metrics.ClockMhz" Unit="MHz" Max="_clockMax" />
            <MetricBar Label="Fan" Value="Metrics.FanRpm" Unit="RPM" Max="_fanMax" />
        </div>
    </div>

    <footer class="card-footer">
        <LoadStatus Percent="Metrics.LoadPercent" />
    </footer>
</section>

@code {
    private double _clockMax;
    private double _fanMax;

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public DeviceMetrics Metrics { get; set; } = DeviceMetrics.Empty;

    [Parameter] public TemperatureUnit TemperatureUnit { get; set; }

    // Clock and fan meters scale against the highest value seen this session, but never below these floors.
    [Parameter] public double ClockFloorMhz { get; set; } = 5000;

    [Parameter] public double FanFloorRpm { get; set; } = 2500;

    private bool IsFahrenheit => TemperatureUnit == TemperatureUnit.Fahrenheit;

    private double? Temperature => IsFahrenheit ? Metrics.TemperatureC * 9 / 5 + 32 : Metrics.TemperatureC;

    private string TemperatureSymbol => IsFahrenheit ? "°F" : "°C";

    // 0–100 °C in either unit, so the meter fills the same amount whichever is shown.
    private (double Min, double Max) TemperatureScale => IsFahrenheit ? (32, 212) : (0, 100);

    protected override void OnParametersSet()
    {
        _clockMax = Math.Max(Math.Max(_clockMax, ClockFloorMhz), Metrics.ClockMhz ?? 0);
        _fanMax = Math.Max(Math.Max(_fanMax, FanFloorRpm), Metrics.FanRpm ?? 0);
    }
}
